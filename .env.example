# --- Core ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qaforge
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=change-me-to-a-32-char-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Storage (MinIO / S3) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=qaforge
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- AI (org-level overrides live in the DB) ---
ANTHROPIC_API_KEY=
AI_DEFAULT_MODEL=claude-sonnet-5-5

# --- Observability ---
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
