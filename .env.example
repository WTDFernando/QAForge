# --- Core ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qaforge
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=change-me-to-a-32-char-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- File storage ---
# local = files on disk (development). s3 = any S3-compatible service (production).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=../../.data/uploads
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=qaforge
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Encryption of environment secrets (optional; 64 hex chars). Defaults to a key derived from BETTER_AUTH_SECRET.
ENCRYPTION_KEY=

# --- AI (org-level overrides live in the DB) ---
# Server-wide fallback key (orgs can set their own in Settings > AI, stored encrypted).
ANTHROPIC_API_KEY=
AI_DEFAULT_MODEL=claude-opus-5-5
# "fake" = offline demo provider (no API calls; for CI and demos). Leave empty for real models.
QAFORGE_AI_PROVIDER=
# Parallel AI jobs per worker process.
AI_CONCURRENCY=4

# --- Observability ---
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Security (Phase 1 hardening) ---
# Signed file links expire after this many seconds.
FILE_URL_TTL_SECONDS=300
# Malware scanning: start `docker compose --profile scan up -d` and set CLAMAV_HOST=localhost.
# Leave empty to skip scanning (files are shown as "not scanned").
CLAMAV_HOST=
CLAMAV_PORT=3310
# Rate limiting (Redis). On by default except in tests. Requests per minute:
# RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_PER_MIN=600
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_AI_PER_MIN=20
