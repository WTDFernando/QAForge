{
  "name": "@qaforge/runner",
  "version": "0.1.0",
  "private": true,
  "description": "Automation engine: API request execution, importers, Playwright test runner.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@qaforge/shared": "workspace:*",
    "ajv": "8.17.1",
    "undici": "7.16.0",
    "yaml": "2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
