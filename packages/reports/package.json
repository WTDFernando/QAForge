{
  "name": "@qaforge/reports",
  "version": "0.1.0",
  "private": true,
  "description": "Report builders (numbers from the database) and renderers: HTML, PDF, DOCX, XLSX, CSV.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@qaforge/db": "workspace:*",
    "@qaforge/shared": "workspace:*",
    "docx": "9.5.1",
    "exceljs": "4.4.0",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^3.2.4",
    "vitest": "^3.2.4"
  }
}
