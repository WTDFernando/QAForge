{
  "name": "@qaforge/worker",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@qaforge/ai": "workspace:*",
    "@qaforge/db": "workspace:*",
    "@qaforge/reports": "workspace:*",
    "@qaforge/runner": "workspace:*",
    "@qaforge/shared": "workspace:*",
    "bullmq": "^5.63.0",
    "ioredis": "^5.8.2",
    "mammoth": "^1.11.0",
    "nodemailer": "6.10.1",
    "pino": "^10.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/nodemailer": "6.4.17",
    "@vitest/coverage-v8": "^3.2.4",
    "exceljs": "4.4.0",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
