{
  "name": "@qaforge/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,node \"tsc -p tsconfig.build.json -w --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --watch dist/main.js\"",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "openapi": "node --env-file-if-exists=../../.env dist/openapi.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/swagger": "^11.2.3",
    "@qaforge/db": "workspace:*",
    "@qaforge/shared": "workspace:*",
    "better-auth": "1.7.21",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "nestjs-pino": "^4.4.1",
    "nestjs-zod": "^5.6.0",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@swc/core": "^1.15.0",
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.1",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.8",
    "vitest": "^3.2.4"
  }
}
